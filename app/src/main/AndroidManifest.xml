<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PLAYO">

        <activity android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SignupActivity" />
        <activity android:name=".MainActivity" />
        <activity android:name=".ProductPage" />
        <activity android:name=".OnclickCategory" />
        <activity android:name=".BookSlotActivity" />

        <!-- Profile related activities -->
        <activity android:name=".PersonalDetailsActivity" />
        <activity android:name=".MyBookingsActivity" />
        <activity android:name=".BookingDetailsActivity" />
        <activity android:name=".MyListingsActivity" />
        <activity android:name=".AddTurfActivity" />
        <activity android:name=".PaymentHistoryActivity" />
        <activity android:name=".SettingsActivity" />
        <activity android:name=".FavoritesActivity" />
        <activity android:name=".NotificationSettingsActivity" />
        <activity android:name=".HelpActivity" />
        <activity android:name=".AboutActivity" />

    </application>

</manifest>